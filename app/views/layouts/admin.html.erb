<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Fashion Paradise | Ladies Tailor</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <!-- Tailwind CSS -->
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  
  <!-- Custom Admin Styles -->
  <style>
    .admin-sidebar {
      transition: transform 0.3s ease-in-out;
    }
    
    .admin-sidebar.collapsed {
      transform: translateX(-100%);
    }
    
    @media (min-width: 768px) {
      .admin-sidebar.collapsed {
        transform: translateX(-260px);
      }
    }
    
    .chart-container {
      position: relative;
      height: 300px;
    }
    
    .fade-in {
      animation: fadeIn 0.5s ease-in;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .hover-scale {
      transition: transform 0.2s ease;
    }
    
    .hover-scale:hover {
      transform: scale(1.02);
    }
  </style>
</head>

<body class="bg-gray-100 font-sans antialiased">
  <div class="flex h-screen overflow-hidden">
    
    <!-- Mobile Sidebar Overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden md:hidden"></div>
    
    <!-- Sidebar -->
    <aside id="admin-sidebar" class="admin-sidebar fixed md:sticky md:top-0 md:left-0 md:z-30 w-64 h-full bg-gradient-to-b from-purple-900 to-purple-800 text-white transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
      <div class="flex flex-col h-full">
        <!-- Logo Section -->
        <div class="p-6 border-b border-purple-700">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8zm-1-13h2v6h-2v-6zm4 6h2v-2h-2v2z"/>
              </svg>
            </div>
            <div>
              <h1 class="text-xl font-bold">Fashion Paradise</h1>
              <p class="text-purple-200 text-sm">Admin Panel</p>
            </div>
          </div>
        </div>
        
        <!-- Navigation -->
        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
          <%= link_to admin_root_path, class: "group flex items-center px-4 py-3 text-purple-100 hover:bg-purple-700 hover:text-white rounded-lg transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-10M7 14l-3-3m0 0l3 3"/>
            </svg>
            Dashboard
          <% end %>
          
          <%= link_to admin_categories_path, class: "group flex items-center px-4 py-3 text-purple-100 hover:bg-purple-700 hover:text-white rounded-lg transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0v6a2 2 0 002 2m14 0V9a2 2 0 00-2-2"/>
            </svg>
            Categories
          <% end %>
          
          <%= link_to admin_categories_path, class: "group flex items-center px-4 py-3 text-purple-100 hover:bg-purple-700 hover:text-white rounded-lg transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0H6a4 4 0 00-8 0v4M9 21a1 1 0 01-1 1h4a1 1 0 011-1v-4M9 7a1 1 0 011-1h4a1 1 0 011 1v4M9 3a1 1 0 011-1h4a1 1 0 011 1"/>
            </svg>
            Products
          <% end %>
          
          <%= link_to admin_customers_path, class: "group flex items-center px-4 py-3 text-purple-100 hover:bg-purple-700 hover:text-white rounded-lg transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-3A3.001 3.001 0 0015 7v8a3 3 0 003 3h5a3 3 0 003-3v-2h-5z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0v8a4 4 0 118 0V7z"/>
            </svg>
            Customers
          <% end %>
          
          <%= link_to admin_bookings_path, class: "group flex items-center px-4 py-3 text-purple-100 hover:bg-purple-700 hover:text-white rounded-lg transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 4h10a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2h8a2 2 0 012 2V7a2 2 0 01-2 2z"/>
            </svg>
            Bookings
          <% end %>
          
          <%= link_to admin_galleries_path, class: "group flex items-center px-4 py-3 text-purple-100 hover:bg-purple-700 hover:text-white rounded-lg transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0l8.586 8.586a2 2 0 012.828 0L16 16m-2-2L1.586 1.586a2 2 0 012.828 0L20 14a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2h8a2 2 0 012 2v6a2 2 0 01-2 2z"/>
            </svg>
            Galleries
          <% end %>
          
          <%= link_to admin_reviews_path, class: "group flex items-center px-4 py-3 text-purple-100 hover:bg-purple-700 hover:text-white rounded-lg transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.221.588-.401.941-.401a2.46 2.46 0 01.941.401l2.433 2.433c.37.37.822.62 1.304.62a2.46 2.46 0 001.304-.62l-2.433-2.433c-.37-.37-.62-.822-.62-1.304 0-.482.25-.822.62-1.304.25-.482.62-.822.62-1.304zM12 17.657l-2.433 2.433C9.211 20.822 8.882 21 8.5 21c8.118 0 7.711-.178-7.5-.535l2.433-2.433c.37-.368.62-.822.62-1.304 0-.482-.25-.822-.62-1.304-.25-.482-.62-.822-.62-1.304z"/>
            </svg>
            Reviews
          <% end %>
          
          <%= link_to edit_admin_business_info_path(BusinessInfo.first), class: "group flex items-center px-4 py-3 text-purple-100 hover:bg-purple-700 hover:text-white rounded-lg transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.573c-.94 1.543-.826 3.31-2.37 2.37A1.724 1.724 0 00-2.573 1.065c-1.543.94-3.31.826-2.37-2.37C11.5 7.5 10.874 6.55 10.874c-1.724 0-3.35-1.756-3.35-3.35z"/>
            </svg>
            Settings
          <% end %>
        </nav>
        
        <!-- Bottom Section -->
        <div class="p-4 border-t border-purple-700 mt-auto">
          <%= link_to "Visit Site", root_path, class: "flex items-center px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg transition-colors text-sm font-medium", target: "_blank" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10A2 2 0 002-2V8a2 2 0 00-2-2h-4M4 11h11M4 16h11"/>
            </svg>
            Visit Site
          <% end %>
          
          <%= link_to logout_path, method: :delete, class: "flex items-center px-4 py-2 text-purple-200 hover:text-white rounded-lg transition-colors text-sm font-medium" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4 4m4-4H3m2 4h6"/>
            </svg>
            Logout
          <% end %>
        </div>
      </div>
    </aside>
    
    <!-- Main Content -->
    <main class="flex-1 md:ml-64 overflow-y-auto">
      <!-- Top Header -->
      <header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-20">
        <div class="px-6 py-4 flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <!-- Mobile Menu Toggle -->
            <button id="mobile-menu-toggle" class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
            
            <!-- Breadcrumb -->
            <nav class="hidden md:flex items-center space-x-2 text-sm">
              <%= link_to admin_root_path, class: "text-purple-600 hover:text-purple-900 font-medium" do %>
                Dashboard
              <% end %>
              <span class="text-gray-400">/</span>
              <span class="text-gray-600">Admin</span>
            </nav>
          </div>
          
          <!-- User Menu -->
          <div class="flex items-center space-x-4">
            <% if current_user %>
              <div class="flex items-center space-x-3">
                <div class="w-8 h-8 bg-purple-600 rounded-full flex items-center justify-center">
                  <span class="text-white text-sm font-bold">
                    <%= current_user.email_address[0].upcase %>
                  </span>
                </div>
                <div class="hidden sm:block">
                  <p class="text-sm font-medium text-gray-900"><%= current_user.email_address %></p>
                  <p class="text-xs text-gray-500">Administrator</p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </header>
      
      <!-- Page Content -->
      <div class="p-6">
        <%= yield %>
      </div>
    </main>
  </div>
  
  <!-- Mobile Menu JavaScript -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      
      if (mobileMenuToggle && sidebar && overlay) {
        mobileMenuToggle.addEventListener('click', function() {
          sidebar.classList.toggle('collapsed');
          overlay.classList.toggle('hidden');
        });
        
        overlay.addEventListener('click', function() {
          sidebar.classList.add('collapsed');
          overlay.classList.add('hidden');
        });
      }
    });
  </script>
</body>
</html>
