<div style="background: white; border-bottom: 1px solid #eee; padding: 1.5rem 0; margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h1 style="font-family: 'Playfair Display', serif; font-size: 2rem; color: #2D0C3F;">Business Info</h1>
      <p style="color: #666;">Update your business contact details.</p>
    </div>
  </div>
</div>

<%= form_with(model: [:admin, @business_info], local: true, class: "admin-card", style: "max-width: 800px; padding: 2.5rem; border-top: 5px solid #AB47BC;") do |form| %>
  <% if @business_info.errors.any? %>
    <div class="alert alert-alert">
      <h4 style="margin: 0 0 0.5rem 0;"><%= pluralize(@business_info.errors.count, "error") %> found:</h4>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <% @business_info.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
    <div>
      <%= form.label :name, "Business Name", class: "form-label", style: "display: block; margin-bottom: 0.5rem; font-weight: 600;" %>
      <%= form.text_field :name, class: "form-input", style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 6px;", required: true %>
    </div>
    
    <div>
      <%= form.label :phone, "Phone Number", class: "form-label", style: "display: block; margin-bottom: 0.5rem; font-weight: 600;" %>
      <%= form.text_field :phone, class: "form-input", style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 6px;", required: true %>
    </div>
  </div>

  <div style="margin-bottom: 2rem;">
    <%= form.label :description, "About Us", class: "form-label", style: "display: block; margin-bottom: 0.5rem; font-weight: 600;" %>
    <%= form.text_area :description, rows: 4, class: "form-textarea", style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 6px; font-family: inherit;", required: true %>
    <p style="margin: 0.5rem 0 0; font-size: 0.85rem; color: #888;">Displayed on the home page hero section.</p>
  </div>

  <div style="margin-bottom: 2rem;">
    <%= form.label :address, "Address", class: "form-label", style: "display: block; margin-bottom: 0.5rem; font-weight: 600;" %>
    <%= form.text_area :address, rows: 2, class: "form-textarea", style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 6px; font-family: inherit;", required: true %>
  </div>
  
  <div style="margin-bottom: 2rem;">
    <%= form.label :hours, "Opening Hours", class: "form-label", style: "display: block; margin-bottom: 0.5rem; font-weight: 600;" %>
    <%= form.text_field :hours, class: "form-input", style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 6px;", required: true %>
  </div>

  <div style="margin-top: 3rem; text-align: right;">
    <%= link_to "Cancel", admin_root_path, style: "margin-right: 1rem; color: #666; text-decoration: none;" %>
    <%= form.submit "Save Changes", class: "btn btn-primary", style: "padding: 0.8rem 2rem; background: #6A1B9A; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;" %>
  </div>
<% end %>
