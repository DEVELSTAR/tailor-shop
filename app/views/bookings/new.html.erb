<div>
  <h1 class="font-bold text-4xl"<% content_for :title, "Book Appointment | Fashion Paradise" %>

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Book Your Appointment</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Ready to transform your vision into reality? Fill in the details below and we'll get back to you shortly.
      </p>
    </div>

    <%= form_with(model: @booking, url: bookings_path, local: true, class: "bg-white shadow-xl rounded-2xl p-8 space-y-6") do |form| %>
      <% if @booking.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
          <div class="text-red-800 font-medium">Please fix the following errors:</div>
          <ul class="mt-2 space-y-1">
            <% @booking.errors.full_messages.each do |message| %>
              <li class="text-red-700 text-sm">• <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Customer Information -->
      <div class="border-b border-gray-200 pb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Your Information</h2>
        
        <%= form.fields_for :customer, builder: ActionView::Helpers::FormBuilder do |customer_fields| %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= customer_fields.label :name, "Full Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= customer_fields.text_field :name, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", required: true %>
            </div>
            
            <div>
              <%= customer_fields.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= customer_fields.telephone_field :phone, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", placeholder: "+91 98765 43210", required: true %>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
            <div>
              <%= customer_fields.label :email, "Email Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= customer_fields.email_field :email, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", placeholder: "your@email.com" %>
            </div>
            
            <div>
              <%= customer_fields.label :address, "Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= customer_fields.text_area :address, rows: 2, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", placeholder: "Your address in Bengaluru" %>
            </div>
          </div>
          
          <div class="mt-6">
            <%= customer_fields.label :preferences, "Special Preferences (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= customer_fields.text_area :preferences, rows: 2, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", placeholder: "Any specific requirements or preferences..." %>
          </div>
        <% end %>
      </div>

      <!-- Booking Details -->
      <div class="border-b border-gray-200 pb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Booking Details</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= form.label :booking_date, "Preferred Booking Date", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.date_field :booking_date, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", min: Date.current, required: true %>
          </div>
          
          <div>
            <%= form.label :delivery_date, "Preferred Delivery Date", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.date_field :delivery_date, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", min: Date.current + 1.day, required: true %>
          </div>
        </div>
        
        <div class="mt-6">
          <%= form.label :notes, "Additional Notes", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_area :notes, rows: 3, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", placeholder: "Any special requirements or occasion details..." %>
        </div>
      </div>

      <!-- Services Selection -->
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Select Services</h2>
        
        <div class="space-y-4" id="booking-items">
          <%= form.fields_for :booking_items do |items_fields| %>
            <% @booking.booking_items.each_with_index do |item, index| %>
              <div class="booking-item bg-gray-50 p-6 rounded-lg border border-gray-200">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                  <div class="lg:col-span-2">
                    <%= items_fields.select :product_id, [], { prompt: "Select a service..." }, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", required: true do %>
                      <% @categories.each do |category| %>
                        <optgroup label="<%= category.name %>">
                          <% category.products.each do |product| %>
                            <option value="<%= product.id %>" data-price="<%= product.price %>">
                              <%= product.name %> - ₹<%= product.price.to_i %>
                            </option>
                          <% end %>
                        </optgroup>
                      <% end %>
                    <% end %>
                  </div>
                  
                  <div>
                    <%= items_fields.label :quantity, "Quantity", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= items_fields.number_field :quantity, min: 1, value: item.quantity || 1, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", required: true %>
                  </div>
                </div>
                
                <div class="mt-4">
                  <%= items_fields.label :notes, "Service Notes", class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <%= items_fields.text_area :notes, rows: 2, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent", placeholder: "Specific requirements for this service..." %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
        
        <!-- Add Service Button -->
        <button type="button" id="add-service-btn" class="mt-4 w-full px-4 py-3 bg-purple-100 text-purple-700 font-semibold rounded-lg hover:bg-purple-200 transition-colors">
          + Add Another Service
        </button>
      </div>

      <!-- Submit Button -->
      <div class="mt-8">
        <%= form.submit "Submit Booking Request", class: "w-full px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-bold rounded-lg hover:from-purple-700 hover:to-pink-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200 transform hover:scale-[1.02]" %>
      </div>
      
      <div class="mt-4 text-center">
        <p class="text-sm text-gray-600">
          By submitting this booking request, you agree to be contacted by Fashion Paradise for confirmation and details.
        </p>
      </div>
    <% end %>
    
    <!-- Back to Home -->
    <div class="mt-8 text-center">
      <%= link_to "← Back to Home", root_path, class: "text-purple-600 hover:text-purple-700 font-medium" %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  let itemIndex = <%= @booking.booking_items.length %>;
  
  // Add service functionality
  document.getElementById('add-service-btn').addEventListener('click', function() {
    const container = document.getElementById('booking-items');
    const newItem = document.createElement('div');
    newItem.className = 'booking-item bg-gray-50 p-6 rounded-lg border border-gray-200 mt-4';
    newItem.innerHTML = `
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-2">Select Service</label>
          <select name="booking[booking_items_attributes][${itemIndex}][product_id]" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent" required>
            <option value="">Select a service...</option>
            <% @categories.each do |category| %>
              <optgroup label="<%= category.name %>">
                <% category.products.each do |product| %>
                  <option value="<%= product.id %>" data-price="<%= product.price %>">
                    <%= product.name %> - ₹<%= product.price.to_i %>
                  </option>
                <% end %>
              </optgroup>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
          <input type="number" name="booking[booking_items_attributes][${itemIndex}][quantity]" min="1" value="1" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent" required>
        </div>
      </div>
      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">Service Notes</label>
        <textarea name="booking[booking_items_attributes][${itemIndex}][notes]" rows="2" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent" placeholder="Specific requirements for this service..."></textarea>
      </div>
    `;
    container.appendChild(newItem);
    itemIndex++;
  });
});
</script>
</div>
