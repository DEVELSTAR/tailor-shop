<% content_for :title, "Gallery | Fashion Paradise" %>
<% content_for :head do %>
  <meta name="description" content="Explore our portfolio of exquisite ladies tailoring work, designer blouses, saree work, and custom creations at Fashion Paradise Bengaluru.">
  <meta name="keywords" content="tailoring gallery, ladies tailor portfolio, blouse design, saree work, bengaluru fashion">
  
  <!-- Open Graph -->
  <meta property="og:title" content="Gallery | Fashion Paradise">
  <meta property="og:description" content="Explore our portfolio of exquisite ladies tailoring work and designer creations">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= asset_path('icon.svg') %>">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Gallery | Fashion Paradise">
  <meta name="twitter:description" content="Explore our portfolio of exquisite ladies tailoring work and designer creations">
<% end %>

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-semibold tracking-wide uppercase mb-4">
        Our Work
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Gallery of Excellence
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Discover our finest craftsmanship through these curated pieces that showcase our attention to detail and design expertise.
      </p>
    </div>

    <!-- Category Filter -->
    <% if @categories.any? %>
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        <%= link_to galleries_path, class: "px-4 py-2 bg-purple-600 text-white rounded-full font-medium hover:bg-purple-700 transition-colors" do %>
          All Work
        <% end %>
        <% @categories.each do |category| %>
          <%= link_to galleries_path(category_id: category.id), class: "px-4 py-2 bg-white text-gray-700 rounded-full font-medium border border-gray-300 hover:bg-gray-50 hover:border-purple-300 transition-colors" do %>
            <%= category.name %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <% @galleries.each do |gallery| %>
        <div class="group relative bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden">
          <!-- Featured Badge -->
          <% if gallery.featured? %>
            <div class="absolute top-4 right-4 z-10">
              <span class="px-3 py-1 bg-amber-500 text-white text-xs font-bold rounded-full">
                Featured
              </span>
            </div>
          <% end %>
          
          <!-- Image -->
          <div class="aspect-square bg-gradient-to-br from-purple-100 to-pink-100 relative overflow-hidden">
            <% if gallery.image.attached? %>
              <%= link_to gallery_path(gallery), class: "block w-full h-full" do %>
                <%= image_tag gallery.image, 
                     class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500",
                     alt: gallery.title,
                     loading: "lazy" %>
              <% end %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-purple-600 font-semibold">
                FASHION PARADISE
              </div>
            <% end %>
          </div>
          
          <!-- Content Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                <!-- Category Badge -->
                <div class="mb-3">
                  <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-xs font-medium">
                    <%= gallery.category_name %>
                  </span>
                </div>
                
                <!-- Title -->
                <h3 class="text-xl font-bold mb-2">
                  <%= gallery.title %>
                </h3>
                
                <!-- Description -->
                <% if gallery.description.present? %>
                  <p class="text-white/90 text-sm line-clamp-2">
                    <%= gallery.description %>
                  </p>
                <% end %>
                
                <!-- View Button -->
                <%= link_to gallery_path(gallery), class: "inline-flex items-center px-4 py-2 bg-white text-purple-900 text-sm font-semibold rounded-lg hover:bg-gray-100 transition-colors" do %>
                  View Details
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                  </svg>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Empty State -->
    <% if @galleries.empty? %>
      <div class="text-center py-20">
        <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0l8.586 8.586a2 2 0 012.828 0L16 16m-2-2l1.586 1.586a2 2 0 012.828 0L20 14a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2h8a2 2 0 012 2v6a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">No Gallery Items Yet</h3>
        <p class="text-gray-600 max-w-md mx-auto">
          We're working on adding our latest work to the gallery. Check back soon to see our beautiful creations!
        </p>
      </div>
    <% end %>

    <!-- Back to Home -->
    <div class="mt-16 text-center">
      <%= link_to "← Back to Home", root_path, class: "text-purple-600 hover:text-purple-700 font-medium" %>
    </div>
  </div>
</div>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Lazy loading animation */
img[loading="lazy"] {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

img[loading="lazy"]:not(.loaded) {
  opacity: 0;
}

img[loading="lazy"].loaded {
  opacity: 1;
  animation: none;
}
</style>
</div>
