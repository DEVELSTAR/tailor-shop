<% content_for :title, "Fashion Paradise | Bespoke Ladies Tailoring in Bengaluru" %>
<% content_for :head do %>
  <meta name="description" content="Expert ladies tailor in HSR Layout, Bengaluru. Specializing in custom stitching, designer blouses, saree work, and modern alterations. Book your consultation today!">
  <meta name="keywords" content="ladies tailor, bengaluru, hsr layout, custom stitching, blouse design, saree work, alterations, fashion paradise">
  
  <!-- Open Graph -->
  <meta property="og:title" content="Fashion Paradise | Bespoke Ladies Tailoring">
  <meta property="og:description" content="Expert ladies tailor in Bengaluru specializing in custom stitching and designer wear">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= asset_path('icon.svg') %>">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Fashion Paradise | Bespoke Ladies Tailoring">
  <meta name="twitter:description" content="Expert ladies tailor in Bengaluru specializing in custom stitching and designer wear">
  <meta name="twitter:image" content="<%= asset_path('icon.svg') %>">
<% end %>

<!-- Hero Section -->
<section id="hero" class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-purple-50 via-pink-50 to-amber-50 overflow-hidden">
  <div class="absolute inset-0 bg-black/10"></div>
  
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-10 left-10 w-72 h-72 border-4 border-purple-300 rounded-full"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 border-4 border-pink-300 rounded-full"></div>
    <div class="absolute top-1/2 left-1/3 w-64 h-64 border-4 border-amber-300 rounded-full"></div>
  </div>
  
  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <div class="mb-6">
      <span class="inline-block px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-semibold tracking-wide uppercase">
        Established in Bengaluru
      </span>
    </div>
    
    <% if @business_info %>
      <h1 class="text-5xl md:text-7xl font-bold text-gray-900 mb-6 leading-tight">
        <%= @business_info.name %>
      </h1>
      <p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-3xl mx-auto leading-relaxed">
        <%= @business_info.description %>
      </p>
    <% else %>
      <h1 class="text-5xl md:text-7xl font-bold text-gray-900 mb-6 leading-tight">
        Fashion Paradise
      </h1>
      <p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-3xl mx-auto leading-relaxed">
        Elevating personal style through exquisite craftsmanship and bespoke tailoring.
      </p>
    <% end %>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <%= link_to "#catalogue", class: "group relative px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold rounded-full hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300" do %>
        <span class="flex items-center gap-2">
          Explore Collections
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </span>
      <% end %>
      
      <%= link_to new_booking_path, class: "group px-8 py-4 bg-white text-purple-600 font-semibold rounded-full border-2 border-purple-200 hover:border-purple-400 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300" do %>
        <span class="flex items-center gap-2">
          Book Appointment
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
        </span>
      <% end %>
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<!-- Stats Section -->
<section class="py-20 bg-white">
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div class="group">
        <div class="text-4xl md:text-5xl font-bold text-purple-600 mb-2 group-hover:scale-110 transition-transform">
          <%= @categories.count %>+
        </div>
        <div class="text-gray-600 font-medium">Service Categories</div>
      </div>
      <div class="group">
        <div class="text-4xl md:text-5xl font-bold text-pink-600 mb-2 group-hover:scale-110 transition-transform">
          <%= @categories.sum { |c| c.products.count } %>+
        </div>
        <div class="text-gray-600 font-medium">Tailoring Services</div>
      </div>
      <div class="group">
        <div class="text-4xl md:text-5xl font-bold text-amber-600 mb-2 group-hover:scale-110 transition-transform">
          <%= @average_rating %>
        </div>
        <div class="text-gray-600 font-medium">Average Rating</div>
      </div>
      <div class="group">
        <div class="text-4xl md:text-5xl font-bold text-green-600 mb-2 group-hover:scale-110 transition-transform">
          <%= @total_reviews %>
        </div>
        <div class="text-gray-600 font-medium">Happy Customers</div>
      </div>
    </div>
  </div>
</section>

<!-- Services Catalogue -->
<section id="catalogue" class="py-20 bg-gray-50">
  <div class="container">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-semibold tracking-wide uppercase mb-4">
        Our Services
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Exquisite Tailoring Services
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        From traditional saree work to contemporary designer wear, we bring your vision to life with precision craftsmanship.
      </p>
    </div>

    <div class="space-y-20">
      <% @categories.each do |category| %>
        <div class="category-section">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 pb-4 border-b border-gray-200">
            <div>
              <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
                <%= category.name %>
              </h3>
              <% if category.description.present? %>
                <p class="text-gray-600 text-lg max-w-2xl">
                  <%= category.description %>
                </p>
              <% end %>
            </div>
            <div class="mt-4 md:mt-0">
              <span class="inline-flex items-center px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-semibold">
                <%= pluralize(category.products.count, 'Service') %>
              </span>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% category.products.each do |product| %>
              <div class="product-card group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100">
                <div class="aspect-video bg-gradient-to-br from-purple-100 to-pink-100 relative overflow-hidden">
                  <% if product.image.attached? %>
                    <%= image_tag product.image, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-purple-600 font-semibold text-lg">
                      FASHION PARADISE
                    </div>
                  <% end %>
                  
                  <% if product.featured? %>
                    <div class="absolute top-4 right-4">
                      <span class="px-3 py-1 bg-amber-500 text-white text-xs font-bold rounded-full">
                        Featured
                      </span>
                    </div>
                  <% end %>
                </div>
                
                <div class="p-6">
                  <h4 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors">
                    <%= product.name %>
                  </h4>
                  
                  <% if product.description.present? %>
                    <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                      <%= truncate(product.description, length: 80) %>
                    </p>
                  <% end %>
                  
                  <div class="flex items-center justify-between">
                    <div class="text-2xl font-bold text-purple-600">
                      <%= product.formatted_price %>
                    </div>
                    <%= link_to "#contact", class: "inline-flex items-center px-4 py-2 bg-purple-600 text-white text-sm font-semibold rounded-lg hover:bg-purple-700 transition-colors" do %>
                      Enquire Now
                      <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                      </svg>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Testimonials Section -->
<section id="reviews" class="py-20 bg-gradient-to-br from-purple-900 to-pink-900 text-white relative overflow-hidden">
  <div class="absolute inset-0 bg-black/20"></div>
  
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 right-20 w-64 h-64 border-4 border-white rounded-full"></div>
    <div class="absolute bottom-20 left-20 w-48 h-48 border-4 border-white rounded-full"></div>
  </div>
  
  <div class="container relative z-10">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-white/20 backdrop-blur-sm text-white rounded-full text-sm font-semibold tracking-wide uppercase mb-4">
        Testimonials
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        Voices of Excellence
      </h2>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        Don't just take our word for it - hear what our valued customers have to say about their experience.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @reviews.each do |review| %>
        <div class="testimonial-card bg-white/10 backdrop-blur-sm rounded-xl p-8 border border-white/20 hover:bg-white/20 transition-all duration-300">
          <div class="flex items-center mb-4">
            <div class="text-yellow-400">
              <% review.rating.times do %>
                <svg class="w-5 h-5 inline" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.538 1.118l2.8-2.034a1 1 0 011.118-.364l3.292 1.07c.921.3.921 1.603 0 1.902l-3.292 1.07a1 1 0 00-.69.95v3.462c0 .969-.24 1.371-1.24.588l-2.034-2.8a1 1 0 00-1.118-.364l-3.292 1.07c-.921.3-1.603.921-1.902 0l-1.07-3.292a1 1 0 00-.95-.69H4.162c-.969 0-1.371-.24-1.588-1.24l2.034-2.8a1 1 0 00.364-1.118L2.98 8.72c-.3-.921.3-1.603 1.902 0l3.292-1.07a1 1 0 00.69-.95V4.162c0-.969.24-1.371 1.24-.588l2.8 2.034a1 1 0 001.118.364l3.292-1.07z"/>
                </svg>
              <% end %>
            </div>
          </div>
          
          <blockquote class="text-white/90 text-lg mb-6 leading-relaxed">
            "<%= review.comment %>"
          </blockquote>
          
          <div class="flex items-center justify-between">
            <div>
              <div class="font-semibold text-white">
                <%= review.reviewer_name %>
              </div>
              <div class="text-white/60 text-sm">
                Verified Customer
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    
    <div class="text-center mt-12">
      <%= link_to new_review_path, class: "inline-flex items-center px-8 py-4 bg-white text-purple-900 font-semibold rounded-full hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300" do %>
        Share Your Experience
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
      <% end %>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-20 bg-white">
  <div class="container">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-semibold tracking-wide uppercase mb-4">
        Visit Our Atelier
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Find Us
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Step into our world of bespoke fashion and let us create something extraordinary for you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <div class="text-center group">
        <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-purple-200 transition-colors">
          <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-4">Location</h3>
        <p class="text-gray-600 leading-relaxed mb-4">
          <%= @business_info&.address || "2nd Cross Rd, Vinayaka Nagar, HSR Layout, Bengaluru, Karnataka 560068" %>
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://maps.google.com/maps?q=<%= URI.encode_www_form_component(@business_info&.address || "2nd Cross Rd, Vinayaka Nagar, HSR Layout, Bengaluru, Karnataka 560068") %>" 
             target="_blank" 
             class="inline-flex items-center px-4 py-2 bg-purple-600 text-white font-semibold rounded-lg hover:bg-purple-700 transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V9a1 1 0 011-1v7.382a1 1 0 01.553.894L15 4h2a1 1 0 011 1v7.382a1 1 0 01-.553.894L9 20z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.485 13.515l-2.828-2.828a1 1 0 00-1.415 0l-4.242 4.243a8 8 0 008.486 8.486l4.242-4.243a1 1 0 001.415 0l2.828 2.829a1 1 0 001.414 0z"></path>
            </svg>
            Get Directions
          </a>
        </div>
      </div>
      
      <div class="text-center group">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-pink-200 transition-colors">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-4">Business Hours</h3>
        <p class="text-gray-600 leading-relaxed">
          <%= @business_info&.hours || "Monday – Saturday: 10:00 AM – 8:30 PM<br>Sunday: 10:00 AM – 8:30 PM" %>
        </p>
      </div>
      
      <div class="text-center group">
        <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-amber-200 transition-colors">
          <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-4">Get In Touch</h3>
        <p class="text-gray-600 mb-4">For inquiries and appointments</p>
        <a href="tel:<%= @business_info&.phone || '+919876543210' %>" class="inline-flex items-center text-purple-600 hover:text-purple-700 font-semibold text-lg">
          <%= @business_info&.phone || '+91 98765 43210' %>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-card {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.product-card:hover {
  transform: translateY(-4px);
}

.testimonial-card {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.testimonial-card:hover {
  transform: translateY(-2px);
}

/* Smooth scrolling */
html {
  scroll-behavior: smooth;
}

/* Custom animations */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.category-section > * {
  animation: fadeInUp 0.6s ease-out forwards;
}
</style>
